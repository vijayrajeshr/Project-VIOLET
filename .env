# VIOLET System Configuration
# Modify settings accordingly

# LLM Backend: "lm-studio", "ollama", or "transformers" (Hugging Face locally)
LLM_BACKEND=lm-studio

# Endpoint URL for LM Studio local server
LM_STUDIO_URL=http://127.0.0.1:1234/v1

# Active Model ID in LM Studio
LM_STUDIO_MODEL=qwen3.5-4b

# Model name to use in Ollama (if backend is ollama)
OLLAMA_MODEL=qwen2.5-coder:latest

# Hugging Face Model ID (for transformers backend)
HF_MODEL_ID=deepseek-ai/DeepSeek-R1-Distill-Qwen-1.5B

# Speech-to-Text Provider: "google" (fast online) or "whisper" (local offline)
STT_PROVIDER=google

# Text-to-Speech Toggle
TTS_ENABLED=true

# SHA256 Hash of Administrator Authorization Code
# The default hash below corresponds to the password "admin"
ADMIN_HASH=8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918
